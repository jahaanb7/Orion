		(uuid "29cd9a57-00f7-4adf-93da-96ed63dc5d47")
	)
	(text "INT — IMU interrupts MCU in order \nto give new information/data \nor tell it that a new event occured\n\nCS — Communicates with IMU \n(Output from MCU)"
